{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "corpus_parent": {
      "minLength": 1,
      "type": "string"
    },
    "documents": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "ACTIVE"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {"required": ["blocked_on"]},
                  {"required": ["recorded_date"]},
                  {"required": ["exclusion_reason"]}
                ]
              },
              "required": [
                "document_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "EXCLUDED"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {"required": ["document_id"]},
                  {"required": ["blocked_on"]},
                  {"required": ["recorded_date"]}
                ]
              },
              "required": [
                "exclusion_reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "PENDING_REVIEW"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {"required": ["document_id"]},
                  {"required": ["exclusion_reason"]}
                ]
              },
              "required": [
                "blocked_on",
                "recorded_date"
              ]
            }
          }
        ],
        "properties": {
          "blocked_on": {
            "enum": [
              "CARRIER_INQUIRY",
              "INTERNAL_DECISION",
              "INTAKE_CAPABILITY"
            ]
          },
          "currentness": {
            "enum": [
              "CURRENT",
              "CURRENTNESS_UNVERIFIED"
            ]
          },
          "document_id": {
            "minLength": 1,
            "type": "string"
          },
          "exclusion_reason": {
            "enum": [
              "DUPLICATE",
              "SUPERSEDED",
              "REFERENCE_ONLY",
              "OUT_OF_SCOPE"
            ]
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "recorded_date": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])",
            "type": "string"
          },
          "root": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "state": {
            "enum": [
              "ACTIVE",
              "EXCLUDED",
              "PENDING_REVIEW"
            ]
          }
        },
        "required": [
          "path",
          "root",
          "state",
          "currentness",
          "size_bytes",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "generator": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "build_corpus_closure"
        },
        "version": {
          "const": "1"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "source_scope_path": {
      "minLength": 1,
      "type": "string"
    },
    "source_scope_sha256": {
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "type": "string"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "minimum": 0,
          "type": "integer"
        },
        "currentness": {
          "additionalProperties": false,
          "properties": {
            "CURRENT": {
              "minimum": 0,
              "type": "integer"
            },
            "CURRENTNESS_UNVERIFIED": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "CURRENT",
            "CURRENTNESS_UNVERIFIED"
          ],
          "type": "object"
        },
        "excluded": {
          "minimum": 0,
          "type": "integer"
        },
        "oldest_pending_recorded_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "pending_by_resolver": {
          "additionalProperties": false,
          "properties": {
            "CARRIER_INQUIRY": {
              "minimum": 0,
              "type": "integer"
            },
            "INTERNAL_DECISION": {
              "minimum": 0,
              "type": "integer"
            },
            "INTAKE_CAPABILITY": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "CARRIER_INQUIRY",
            "INTERNAL_DECISION",
            "INTAKE_CAPABILITY"
          ],
          "type": "object"
        },
        "pending_review": {
          "minimum": 0,
          "type": "integer"
        },
        "roots": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "active": {
                "minimum": 0,
                "type": "integer"
              },
              "excluded": {
                "minimum": 0,
                "type": "integer"
              },
              "pending_review": {
                "minimum": 0,
                "type": "integer"
              },
              "total": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "active",
              "excluded",
              "pending_review",
              "total"
            ],
            "type": "object"
          },
          "type": "object"
        },
        "total": {
          "minimum": 0,
          "type": "integer"
        },
        "unclassified": {
          "const": 0
        }
      },
      "required": [
        "total",
        "active",
        "excluded",
        "pending_review",
        "unclassified",
        "roots",
        "pending_by_resolver",
        "oldest_pending_recorded_date",
        "currentness"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "generator",
    "source_scope_path",
    "source_scope_sha256",
    "corpus_parent",
    "documents",
    "summary"
  ],
  "title": "G0-A.1 Corpus Closure v1",
  "type": "object"
}
