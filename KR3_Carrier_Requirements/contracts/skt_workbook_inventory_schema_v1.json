{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SKT Workbook Structural Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "workbooks"],
  "properties": {
    "schema_version": {"const": 1},
    "tool": {"const": "skt-workbook-inventory-v1"},
    "workbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "path", "source_sha256", "acquisition_status", "error_code", "sheet_count", "sheets"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
          "acquisition_status": {"enum": ["READABLE", "FAILED"]},
          "error_code": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^(?:SOURCE_HASH_DRIFT|EXCEL_COM_[0-9A-F]{8})(?![\\s\\S])"}
            ]
          },
          "sheet_count": {"type": "integer", "minimum": 0},
          "sheets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sheet_index", "sheet_name", "visibility", "used_range"],
              "properties": {
                "sheet_index": {"type": "integer", "minimum": 1},
                "sheet_name": {"type": "string", "minLength": 1},
                "visibility": {"enum": ["VISIBLE", "HIDDEN", "VERY_HIDDEN"]},
                "used_range": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["first_row", "last_row", "first_column", "last_column"],
                  "properties": {
                    "first_row": {"type": "integer", "minimum": 1},
                    "last_row": {"type": "integer", "minimum": 1},
                    "first_column": {"type": "integer", "minimum": 1},
                    "last_column": {"type": "integer", "minimum": 1}
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"acquisition_status": {"const": "READABLE"}}},
            "then": {
              "properties": {
                "error_code": {"type": "null"},
                "sheet_count": {"minimum": 1},
                "sheets": {"minItems": 1}
              }
            }
          },
          {
            "if": {"properties": {"acquisition_status": {"const": "FAILED"}}},
            "then": {
              "properties": {
                "error_code": {"type": "string", "minLength": 1},
                "sheet_count": {"const": 0},
                "sheets": {"maxItems": 0}
              }
            }
          }
        ]
      }
    }
  }
}
