# Shell scripts must stay LF — CRLF breaks shebang / case / heredoc under Git Bash on Windows.
# (repo runs with core.autocrlf=true, which would otherwise emit CRLF on a fresh checkout)
*.sh text eol=lf

# Windows batch files must stay CRLF (some environments fail on LF).
*.bat text eol=crlf

# Frozen policy/evidence bytes are SHA-bound and must be checkout-stable.
scripts/canonical_shell_rc_risk_policy_v1.json text eol=lf
"THOR2_J - Settings/RESULT_2026-07-24.md" text eol=lf
